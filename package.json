{
  "name": "cadence-ai",
  "version": "0.5.0",
  "description": "A local-first desktop widget and CLI charting your Claude Code, Codex and Cursor rhythm.",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "bin": {
    "cadence": "src/cli.js",
    "cadence-server": "src/server.js"
  },
  "scripts": {
    "start": "electron .",
    "graph": "node src/cli.js",
    "server": "node src/server.js --no-open",
    "export": "node src/server.js --export ./out",
    "test": "node --test",
    "build:icon": "node scripts/build-icon.mjs",
    "build:exe": "npm run build:icon && electron-builder --win nsis zip"
  },
  "build": {
    "appId": "dev.cadence.widget",
    "productName": "Cadence",
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**/*",
      "electron/**/*",
      "public/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/cadence.ico",
      "artifactName": "cadence-win-x64.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cadence",
      "uninstallDisplayName": "Cadence",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "cadence-setup.exe",
      "include": "installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  }
}
