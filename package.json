{
  "name": "cadence-ai",
  "version": "0.2.1",
  "description": "A local-first desktop widget charting your Claude Code and Codex rhythm.",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "bin": {
    "cadence-server": "src/server.js"
  },
  "scripts": {
    "start": "electron .",
    "server": "node src/server.js --no-open",
    "export": "node src/server.js --export ./out",
    "test": "node --test",
    "build:icon": "node scripts/build-icon.mjs",
    "build:exe": "npm run build:icon && electron-builder --win portable"
  },
  "build": {
    "appId": "dev.cadence.widget",
    "productName": "Cadence",
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**/*",
      "electron/**/*",
      "public/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/cadence.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "cadence.exe"
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  }
}
